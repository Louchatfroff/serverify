{
	"schemaVersion": 1,
	"id": "serverify",
	"version": "${version}",
	"name": "Serverify",
	"description": "In-game Minecraft server browser.",
	"authors": ["Louchatfroff"],
	"contact": {
		"homepage": "https://serverify.louchat.site",
		"sources": "https://github.com/Louchatfroff/serverify",
		"issues": "https://github.com/Louchatfroff/serverify/issues"
	},
	"license": "GPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": ["com.serverify.client.ServerifyClient"],
		"modmenu": ["com.serverify.client.ServerifyModMenu"]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_version}",
		"${fabric_api_id}": "*",
		"fabric-language-kotlin": ">=1.11.0+kotlin.2.0.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}
